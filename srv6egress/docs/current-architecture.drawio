<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="current-architecture-as-built" id="asbuilt01">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title ===== -->
        <mxCell id="title" value="srv6egress — 実機 as-built アーキテクチャ（2026-06-16 検証済み: egress-app から ICMP 3/3 + TCP A2-TCP-OK / trace で podIP→VIP SNAT 確認）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Control plane band ===== -->
        <mxCell id="r_ctrl" value="control plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="crd" value="EgressPolicy CRD&#10;tenant-a-via-isp-a&#10;color 100 / dst 2001:db8:a::/64&#10;VIP 2001:db8:e:0:b91:…&#10;endpoint=srte-egress-1 / Ready=True*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="250" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_proc" value="bgp-controller&#10;⚠ OFFLINE（プロセス停止中）&#10;→ Ready は手動 override(*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="78" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="calico-vpp-agent（各ノード）&#10;• headend: SrSteer 設定（Ready ゲート）&#10;• GW: GatewayManager が provision/teardown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="610" y="78" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_note" value="* controller 死亡 → Ready=False → GW agent が GW dataplane を自動撤去（今回の障害）。&#10;今は手動 restore + Ready=True override で稼働。恒久化は controller 復活が必要。" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="950" y="78" width="500" height="64" as="geometry" />
        </mxCell>

        <!-- ===== Region: cluster ===== -->
        <mxCell id="r_cluster" value="cluster SR domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="300" height="470" as="geometry" />
        </mxCell>
        <mxCell id="pod" value="Pod: egress-app（tenant-a）&#10;src = fd20::…:3194&#10;label egress=tenant-a&#10;intent: color 100 → 2001:db8:a::/64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="220" width="250" height="92" as="geometry" />
        </mxCell>
        <mxCell id="headend" value="Headend = worker-1（fd00:1::11）&#10;&#10;• SrSteer: dst 2001:db8:a::/64 → BSID cafe::e0a&#10;• SR policy cafe::e0a&#10;    Segment List = &lt; fcff:0:0:e0:a:: &gt;&#10;    EncapSrc = fd00:1::11&#10;• SRv6 encap（outer = cluster SID）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="360" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cl_note" value="RFC 8402: per-flow state は headend に限定。&#10;pod は backbone/SID 列を知らない（network opacity）" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#3b5b8f;" vertex="1" parent="1">
          <mxGeometry x="55" y="560" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Region: GW (BR) ===== -->
        <mxCell id="r_gw" value="egress GW = srte-egress-1（fd00:1::14）= Border Router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="620" height="560" as="geometry" />
        </mxCell>

        <mxCell id="decap" value="GW 入口: End.DT6.In（VPP patch 0006）&#10;localsid fcff:0:0:e0:a:: on loop1000（fd6e::3e8）&#10;decap → sw_if_index[RX]=loop1000 で ip6-input 再注入 → cnat arc が走る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="580" height="60" as="geometry" />
        </mxCell>

        <mxCell id="vrf_t" value="tenant VRF 1000（fib 16）&#10;&#10;• cnat SNAT: podIP → VIP&#10;    2001:db8:e:0:b91:ca7f:1e60:6840&#10;    （per-fib, VPP patch 0007）&#10;• return un-SNAT: VIP → podIP&#10;• ::/0 → ip6-lookup-in-table 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="vrf_u" value="upstream VRF 100（isp-a）&#10;&#10;• 2001:db8:a::/64 → tap99&#10;    (via 2001:db8:bb::2)&#10;• VIP/128 bounce&#10;    → ip6-lookup-in-table 1000&#10;    （戻りを tenant VRF で un-SNAT）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="290" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="ret_sr" value="戻り路（return）: un-SNAT 後 dst=pod → fd20::/64 → fib0 → SrSteer cafe::aaaa → SR encap &lt; fcff::11aa:…:31a4 &gt;（worker-1 の実 End.DT6 SID）→ worker-1 で decap → pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#b85450;align=center;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="580" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gw_note" value="⚠ 戻り路は agent が auto-provision しない（手動 cafe::aaaa 依存・GW restart で消える）= v1alpha2 コード gap" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="544" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gw_snat_note" value="patch 0006 = End.DT6.In（decap→ip6-input 再注入で cnat arc に乗せる）&#10;patch 0007 = cnat per-fib SNAT（テナント毎に VIP 隔離。fib=fib INDEX）" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#7a6000;" vertex="1" parent="1">
          <mxGeometry x="400" y="590" width="580" height="36" as="geometry" />
        </mxCell>

        <!-- ===== Region: sim-backbone ===== -->
        <mxCell id="r_bb" value="sim-backbone（GW VPP の tap99 + bbns netns・可逆な検証用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="300" height="470" as="geometry" />
        </mxCell>
        <mxCell id="tap" value="tap99  2001:db8:bb::1&#10;   ⇅&#10;simbb  2001:db8:bb::2（bbns netns）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1065" y="290" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="responder（外部 service 模擬）&#10;2001:db8:a::1&#10;• ICMP 自動応答&#10;• perl HTTP :8080 → &quot;A2-TCP-OK&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1065" y="400" width="250" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Forward edges (solid) ===== -->
        <mxCell id="e_pod_he" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#3b5b8f;strokeWidth=2;" edge="1" parent="1" source="pod" target="headend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_he_gw" value="SRv6 [outer = fcff:0:0:e0:a::]&#10;→ route fd00:1::14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#3b5b8f;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="headend" target="decap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_decap_t" value="decap inner&#10;→ SNAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="decap" target="vrf_t">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_t_u" value="::/0 lookup-in-table 100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="vrf_t" target="vrf_u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u_tap" value="2001:db8:a::/64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="vrf_u" target="tap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tap_resp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="tap" target="resp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Return edge (dashed) ===== -->
        <mxCell id="e_return" value="return 対称: un-SNAT(VIP→pod) → fib0 SR encap → pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=9;fontColor=#b85450;" edge="1" parent="1" source="resp" target="ret_sr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="700" />
              <mxPoint x="690" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ret_pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="ret_sr" target="headend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Control edges (dotted) ===== -->
        <mxCell id="e_agent_he" value="steer (Ready ゲート)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;dashPattern=1 4;strokeColor=#9673a6;strokeWidth=1.5;fontSize=9;fontColor=#6a4a8a;" edge="1" parent="1" source="agent" target="headend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_agent_gw" value="provision GW dataplane" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;dashPattern=1 4;strokeColor=#9673a6;strokeWidth=1.5;fontSize=9;fontColor=#6a4a8a;" edge="1" parent="1" source="agent" target="decap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="凡例:  ━━ forward（data）   ┅┅ return 対称   ··· control plane&#10;検証 2026-06-16: egress-app（busybox, tenant-a, worker-1）から 2001:db8:a::1 へ ICMP 3/3 + TCP(wget→A2-TCP-OK)。GW trace で fd20::…:3194 → VIP 2001:db8:e:0:b91:… の SNAT 発火を確認。&#10;住所: cluster SID=fcff:0:0:e0:a:: / BSID=cafe::e0a / tenant VIP=2001:db8:e:0:b91:ca7f:1e60:6840 / tenant VRF=1000(fib16) / upstream VRF=100 / 戻り SID=fcff::11aa:…:31a4&#10;⚠ 現状の運用注意: (1) bgp-controller OFFLINE → Ready は手動 override  (2) 戻り路 cafe::aaaa は手動・GW restart で消える  (3) sim-backbone は検証用（tap99/bbns/perl）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1300" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
