<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="full-feature-testbed" id="fulltb01">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="egress GW フル機能テストベッド — 2 テナント × 2 color × backbone(BR) × failover × 動的 CRUD を 1 環境で。Dell ×2 + DCS201 ×1。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1400" height="26" as="geometry" />
        </mxCell>

        <!-- ===== Server-1 ===== -->
        <mxCell id="s1" value="Server-1（Dell）— cluster + egress GW + control plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="540" height="490" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="pod tenant-a（color 100）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="pb" value="pod tenant-b（color 200）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="wk" value="headend = worker（Calico-VPP）&#10;SrSteer（selector × destCIDR → BSID）&#10;cluster SID で SR encap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="bgp-controller（infra VM）&#10;• EgressPolicy reconcile（CRUD）&#10;• VIP alloc（Calico IPAM）&#10;• color→upstream/SID 解決&#10;• SR Policy 配布 + persist-then-announce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="egress GW = Border Router（VPP + patch 0006/0007）&#10;&#10;• End.DT6.In decap（cluster SID）&#10;• per-tenant SNAT（VRF-a→VIP-a / VRF-b→VIP-b）&#10;  ＝テナント隔離&#10;• per-VRF eBGP（upstream FIB / VIP advertise）&#10;• BR: 9252(VIP own End SID) + 9012 + Color&#10;• cluster SID decap → backbone SID re-encap&#10;• return: un-SNAT → cluster SR で pod へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="260" height="240" as="geometry" />
        </mxCell>

        <!-- ===== DCS201 ===== -->
        <mxCell id="sw" value="DCS201&#10;（SONiC）&#10;&#10;HW L3 ECMP&#10;fabric&#10;（underlay）&#10;&#10;SID locator を&#10;ASIC で転送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;fontStyle=1;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="56" width="150" height="490" as="geometry" />
        </mxCell>

        <!-- ===== Server-2 ===== -->
        <mxCell id="s2" value="Server-2（Dell）— operator SRv6 backbone（FRR + Linux kernel SRv6）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="770" y="56" width="650" height="490" as="geometry" />
        </mxCell>
        <mxCell id="pe1" value="PE-A（color 100）&#10;End.DT6 / RFC9252 L3VPN&#10;loc fcbb:0:a::/48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sx" value="service-X&#10;2001:db8:svc-x::/64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fff5;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pp" value="P1 / P2（SR transit）&#10;ECMP・failover 用の冗長 2 経路&#10;loc fcbb:0:c::/48（anycast 可）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="240" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pe2" value="PE-B（color 200）&#10;End.DT6 / RFC9252 L3VPN&#10;loc fcbb:0:b::/48" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="370" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sy" value="service-Y&#10;2001:db8:svc-y::/64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="370" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- intra flows -->
        <mxCell id="e_pa" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="pa" target="wk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pb" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="pb" target="wk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_wk" value="cluster SID" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="wk" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ctl" value="reconcile" style="endArrow=open;html=1;dashed=1;dashPattern=1 4;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="ctl" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pe1sx" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="pe1" target="sx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pe2sy" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="pe2" target="sy"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- GW <-> fabric <-> backbone (2 colored paths) -->
        <mxCell id="e_gw_sw_a" value="color100 path" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2.5;fontSize=9;" edge="1" parent="1" source="gw" target="sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="200" /></Array></mxGeometry></mxCell>
        <mxCell id="e_gw_sw_b" value="color200 path" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2.5;fontSize=9;" edge="1" parent="1" source="gw" target="sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="e_sw_p" value="HW ECMP" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="sw" target="pp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p_pe1" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="pp" target="pe1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p_pe2" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="pp" target="pe2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- legend -->
        <mxCell id="legend" value="この環境で exercise できる egress GW 機能（緑=tenant-a/color100→PE-A→service-X、橙=tenant-b/color200→PE-B→service-Y）:&#10;① headend SR steering（selector×destCIDR）  ② color パス選択（100/200 で別 PE/service）  ③ End.DT6.In decap  ④ per-tenant SNAT 隔離（VIP-a≠VIP-b）  ⑤ VIP 自動払い出し(Calico IPAM)+advertise&#10;⑥ per-VRF eBGP（upstream FIB / VIP advertise）  ⑦ BR: 9252(VIP own End SID)+9012+Color 連続  ⑧ cluster SID decap→backbone SID re-encap  ⑨ return 対称(un-SNAT)  ⑩ ICMP+TCP(stateful)&#10;⑪ failover（P1/P2 ECMP・eBGP withdraw・SR Policy candidate-path）  ⑫ 動的 CRUD（EgressPolicy 作成/更新/削除→controller→agent）  ⑬ resilience（persist-then-announce #19 / watch 再接続 prune #20 / install retry）&#10;⑭(future) uSID 符号化比較 / HA endpoint。&#10;DCS201=SONiC の HW L3 ECMP fabric が SID locator を ASIC 転送（underlay）。SR 機能は GW=VPP(独自) / PE・P=FRR+kernel(標準)＝異実装相互運用も同時に検証。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1380" height="170" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
