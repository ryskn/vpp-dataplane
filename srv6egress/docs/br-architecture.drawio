        <!-- ===== Backbone PE-edge A / B ===== -->
        <mxCell id="peA" value="vendor BR-A（Cisco 8000 系）&#10;• uA = EPE peering SID（RFC 9087）&#10;• own End SID / uDT46&#10;• ISP peering の経路解決&#10;• backbone SR Policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="980" width="250" height="118" as="geometry" />
        </mxCell>
        <mxCell id="peB" value="vendor BR-B（Cisco 8000 系）&#10;• uA = EPE peering SID（RFC 9087）&#10;• own End SID / uDT46&#10;• ISP peering の経路解決&#10;• backbone SR Policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="980" width="250" height="118" as="geometry" />
        </mxCell>

        <!-- ===== backbone fabric ===== -->
        <mxCell id="fabric" value="SRv6 backbone fabric（operator）&#10;PE-A ── P ── P ── PE-Z ── service-X ／ BR ── ISP peers（EPE）&#10;• end-to-end SR-TE　• color steering（backbone-wide）　• SRv6 L3VPN / EVPN services　• upstream 選択 = BR の uA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="1170" width="720" height="120" as="geometry" />
        </mxCell>

        <!-- ===== core note (8.5.1) ===== -->
        <mxCell id="note" value="一体化の核（§8.5.1）&#10;&#10;cluster の color と backbone の color が&#10;inter-AS Color Extended Community で&#10;連続する。&#10;&#10;intent（color）は source 保持（NAT-less）でも&#10;失われず、backbone TE class に対応づく。&#10;&#10;upstream（peer/transit）選択は BR の&#10;uA（EPE, RFC 9087）を segment list 末尾に&#10;積むだけ ― GW に per-ISP eBGP 不要。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="486" width="200" height="290" as="geometry" />
        </mxCell>

