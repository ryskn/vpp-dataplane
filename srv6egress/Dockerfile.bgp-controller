# bgp-controller image — the central EgressPolicy reconciler.
#
# Build context is the repository ROOT (go.mod lives there):
#   docker build -f srv6egress/Dockerfile.bgp-controller -t <ref> .
FROM golang:1.26 AS build
WORKDIR /src
COPY . .
ARG GIT_COMMIT=unknown
ARG VERSION=v1alpha1-dev
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags "-s -w -X main.buildVersion=${VERSION} -X main.buildCommit=${GIT_COMMIT}" \
    -o /out/bgp-controller ./srv6egress/cmd/bgp-controller

# Distroless static: the binary is CGO-free and only talks to the k8s API and a
# gobgp gRPC endpoint, so it needs no shell, libc, or root.
FROM gcr.io/distroless/static:nonroot
LABEL org.opencontainers.image.title="srv6egress-bgp-controller"
LABEL org.opencontainers.image.source="https://github.com/ryskn/vpp-dataplane"
COPY --from=build /out/bgp-controller /bin/bgp-controller
USER 65532:65532
ENTRYPOINT ["/bin/bgp-controller"]
