From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ryskn <ryosuke.nakayama@ryskn.com>
Date: Sun, 14 Jun 2026 15:18:30 +0000
Subject: [PATCH] cnat: make per-VRF snat address truly per-fib

---
 src/plugins/cnat/cnat_snat_policy.c | 21 +++++++++++++++++----
 src/plugins/cnat/cnat_snat_policy.h | 18 ++++++++++++++++++
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/src/plugins/cnat/cnat_snat_policy.c b/src/plugins/cnat/cnat_snat_policy.c
index 717df6a12..7c888e408 100644
--- a/src/plugins/cnat/cnat_snat_policy.c
+++ b/src/plugins/cnat/cnat_snat_policy.c
@@ -576,8 +576,8 @@ cnat_set_snat (u32 fwd_fib_index, u32 ret_fib_index, const ip4_address_t *ip4, u
    *  - update only ip4
    *  - update only ip6
    *  - update both ip4 & ip4 or sw_if_index */
-  cpe4 = cnat_snat_policy_entry_get (AF_IP4, fwd_fib_index);
-  cpe6 = cnat_snat_policy_entry_get (AF_IP6, fwd_fib_index);
+  cpe4 = cnat_snat_policy_entry_get_exact (AF_IP4, fwd_fib_index);
+  cpe6 = cnat_snat_policy_entry_get_exact (AF_IP6, fwd_fib_index);
   ASSERT (cpe4 == cpe6 || (!sw_if_set && !(ip4_set && ip6_set)));
   cpe = cpe4 ? cpe4 : cpe6;
 
@@ -600,7 +600,18 @@ cnat_set_snat (u32 fwd_fib_index, u32 ret_fib_index, const ip4_address_t *ip4, u
       /* not found: create new entry */
       if (is_delete)
 	return VNET_API_ERROR_FEATURE_DISABLED;
+      /* pool_get may reallocate the pool, dangling snat_default_policy (a raw
+       * pointer into it). Capture its index while the pointer is still valid
+       * and re-resolve it after, so a per-fib set that grows the pool does not
+       * leave the default policy pointing at freed memory (the datapath calls
+       * cpe->snat_policy() on it -> jump to garbage). */
+      u32 cnat_default_idx =
+	cpm->snat_default_policy ?
+	  (u32) (cpm->snat_default_policy - cpm->snat_policies_pool) : ~0;
       pool_get_zero (cpm->snat_policies_pool, cpe);
+      if (cnat_default_idx != (u32) ~0)
+	cpm->snat_default_policy =
+	  pool_elt_at_index (cpm->snat_policies_pool, cnat_default_idx);
       cnat_translation_register_addr_add_cb (CNAT_RESOLV_ADDR_SNAT, cnat_if_addr_add_del_snat_cb);
       cpe->snat_policy = cnat_snat_policy_none;
       cnat_init_port_allocator (fwd_fib_index, flags);
@@ -693,6 +704,7 @@ cnat_set_snat_cli (vlib_main_t *vm, unformat_input_t *input,
   u32 sw_if_index = INDEX_INVALID;
   u32 fwd_fib_index = CNAT_FIB_TABLE;
   u32 ret_fib_index = CNAT_FIB_TABLE;
+  int fib_set = 0;
   int rv;
 
   cnat_lazy_init ();
@@ -711,7 +723,7 @@ cnat_set_snat_cli (vlib_main_t *vm, unformat_input_t *input,
 			      &sw_if_index))
 	;
       else if (unformat (line_input, "fib %d", &fwd_fib_index))
-	;
+	fib_set = 1;
       else if (unformat (line_input, "rfib %d", &ret_fib_index))
 	;
       else
@@ -723,7 +735,8 @@ cnat_set_snat_cli (vlib_main_t *vm, unformat_input_t *input,
     }
 
   rv = cnat_set_snat (fwd_fib_index, ret_fib_index, &ip4, 32, &ip6, 128, sw_if_index,
-		      CNAT_SNAT_POLICY_FLAG_USE_AS_DEFAULT);
+		      fib_set ? CNAT_SNAT_POLICY_FLAG_NONE :
+				CNAT_SNAT_POLICY_FLAG_USE_AS_DEFAULT);
   if (rv)
     {
       e = clib_error_return (0, "unknown error %d", rv);
diff --git a/src/plugins/cnat/cnat_snat_policy.h b/src/plugins/cnat/cnat_snat_policy.h
index a68ff2366..6c55ed678 100644
--- a/src/plugins/cnat/cnat_snat_policy.h
+++ b/src/plugins/cnat/cnat_snat_policy.h
@@ -136,6 +136,24 @@ cnat_snat_policy_entry_get__ (ip_address_family_t af, u32 fwd_fib_index)
   return pool_elt_at_index (cpm->snat_policies_pool, cpe_index);
 }
 
+/* Like cnat_snat_policy_entry_get__ but never falls back to the default
+ * policy: returns NULL when fwd_fib_index has no own entry. cnat_set_snat
+ * uses this to decide create-vs-update, so a second VRF's snat set cannot
+ * reuse (and overwrite) the default / another VRF's entry. */
+static_always_inline cnat_snat_policy_entry_t *
+cnat_snat_policy_entry_get_exact (ip_address_family_t af, u32 fwd_fib_index)
+{
+  cnat_snat_policy_main_t *cpm = &cnat_snat_policy_main;
+  u32 *cp_fwd_fib_index =
+    AF_IP4 == af ? cpm->snat_policy_per_fwd_fib_index4 : cpm->snat_policy_per_fwd_fib_index6;
+  if (fwd_fib_index >= vec_len (cp_fwd_fib_index))
+    return 0;
+  u32 cpe_index = vec_elt (cp_fwd_fib_index, fwd_fib_index);
+  if (~0 == cpe_index)
+    return 0;
+  return pool_elt_at_index (cpm->snat_policies_pool, cpe_index);
+}
+
 cnat_snat_policy_entry_t *cnat_snat_policy_entry_get (ip_address_family_t af, u32 fwd_fib_index);
 
 cnat_snat_policy_entry_t *cnat_snat_policy_entry_get_default (void);
